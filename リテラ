<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>原稿用紙枚数チェッカー</title>
  <style>
    body { font-family: sans-serif; padding: 20px; max-width: 500px; margin: 0 auto; background: #f9f9f9; }
    textarea { width: 100%; height: 150px; padding: 10px; box-sizing: border-box; border-radius: 8px; border: 1px solid #ccc; font-size: 16px; }
    .result { margin-top: 15px; padding: 15px; background: #fff; border-radius: 8px; border: 1px solid #ddd; text-align: center; }
    .pages { font-size: 2rem; font-weight: bold; color: #059669; }
  </style>
</head>
<body>
  <h2>📄 原稿用紙換算ツール</h2>
  <textarea id="text-input" placeholder="文章を入力してください..."></textarea>
  <div class="result">
    <div>原稿用紙（400字詰）換算</div>
    <div class="pages" id="page-count">約 0 枚</div>
  </div>

  <script>
    document.getElementById('text-input').addEventListener('input', (e) => {
      const len = e.target.value.length;
      const pages = Math.ceil(len / 400);
      document.getElementById('page-count').textContent = `約 ${pages} 枚`;
    });
  </script>
</body>
</html>
